# Supabase transaction-pooler URL for the least-privilege API role.
DATABASE_URL=postgresql://club_api.<project-ref>:replace-me@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=5

# Optional local-only URL used only by `npm run prisma:pull` when the API role
# cannot introspect the hosted schema. Never commit a real value.
PRISMA_INTROSPECTION_DATABASE_URL=
# Optional timeout for Prisma introspection. Defaults to 60000 ms.
PRISMA_INTROSPECTION_TIMEOUT_MS=60000

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=replace-me
# Configure exactly one of these two JWT verification methods.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
API_CORS_ORIGINS=http://localhost:5173
API_PORT=3001
API_RATE_LIMIT=120
LOG_LEVEL=info

# apps/web/.env.local uses the VITE_ names below.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-hosted-anon-key
VITE_DEFAULT_CLUB_ID=20000000-0000-0000-0000-000000000001

# supabase/functions/.env is only used by Edge Functions. Never expose this in Vite.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
EMAIL_PROVIDER=
